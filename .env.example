# Copy to .env.local for local dev with `vercel dev`. On Vercel, set these in Project Settings > Environment Variables.
ANTHROPIC_API_KEY=sk-ant-your-key-here
# Optional: override the model (default is a small, cheap Haiku-class model)
# PICK_MODEL=claude-haiku-4-5-20251001

# Live "where to watch" for movies and series (optional). A free key from https://www.themoviedb.org/settings/api
# Without it the page simply keeps its built-in answers. Never put this key in index.html.
TMDB_API_KEY=your-tmdb-v3-api-key-here
